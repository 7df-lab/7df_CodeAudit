# =============================================================================
# CodeAudit 生产模拟环境变量（deploy/env.sim）
# 真实值放 deploy/env.sim（gitignore）；本模板可提交。
# 用法: deploy/sim.sh up 自动 source 本文件（存在时）。
# =============================================================================

# JWT 签名密钥（模拟栈独立于生产；openssl rand -hex 24）
CODEAUDIT_JWT_SECRET=sim-secret-change-me

# 注册策略（2026-10-03 起 overlay 透传到 project 容器；留空/删行=用配置文件档位
# invitation+空码表=注册关闭）。要开放 sim 自助注册：二选一——
#   注邀请码: CODEAUDIT_INVITE_CODES=CODEAUDIT-SIM-2026（逗号分隔多码）
#   或开放档: CODEAUDIT_REGISTRATION_MODE=open（邀请码免填）
CODEAUDIT_REGISTRATION_MODE=
CODEAUDIT_INVITE_CODES=

# 宿主发布端口（1xxxx 段，与生产 8080/8090 隔离）
CODEAUDIT_HOST_GATEWAY=18080
CODEAUDIT_SIM_WEB_PORT=18088

# 中间件/gRPC 宿主端口重映射（与生产同 daemon 共存的前提：base compose 会发布
# 5432/6379/9000/9001/9092/50051-50058，生产占这些口——sim 不重映射则 up 报
# 端口冲突；e2e 只走 18080/18088 HTTP 面，重映射不影响被测链路）
# Kafka 广播地址（2026-10-04 演练实录：缺此键则 compose 死缺省拨 107 地址→
# 换宿主必 unhealthy；107 实证值=服务名 kafka，sim.sh 已将其提为缺省，显式可省）
#CODEAUDIT_KAFKA_ADVERTISED=kafka
CODEAUDIT_HOST_PG=15432
CODEAUDIT_HOST_REDIS=16379
CODEAUDIT_HOST_MINIO_API=19000
CODEAUDIT_HOST_MINIO_CONSOLE=19001
CODEAUDIT_HOST_KAFKA=19092
CODEAUDIT_HOST_SAST_ADAPTER=15051
CODEAUDIT_HOST_PROJECT=15052
CODEAUDIT_HOST_TASK=15054
CODEAUDIT_HOST_STORAGE=15055
CODEAUDIT_HOST_RUNTIME=15057
CODEAUDIT_HOST_RESULT=15058

# 模拟网内 Kafka 广播名（全部客户端均为容器，走内网 DNS）
CODEAUDIT_KAFKA_ADVERTISED=kafka

# 端口缺省已由 sim.sh 统一导出（上方实值段即覆盖入口，改这里即可，无第二份清单）

# OpenShell 沙箱管理微服务（外部依赖；AI 全链测试需要可达 +
# manager 侧存在 dsh-pentest-sse:1.2.3 镜像。留空则 AI 类任务断言"诚实降级"）
# 注意 URL 里的 IP 是当前 107(LXC) 的地址——换宿主/换 LXC 网段时须改成新宿主可达地址
OPENSHELL_MANAGER_URL=http://192.0.2.122:18800
OPENSHELL_MANAGER_TOKEN=

# ---- baton 投影钩子（TP17-T1/ADR-237；sim overlay 将目录卷挂载进 runtime，
# 容器内 BATON_BIN=/usr/local/codeaudit-baton/baton）。宿主目录内投放 baton 静态
# 二进制（baton 仓 CGO_ENABLED=0 构建，alpine 兼容）；缺省 /opt/codeaudit-sim/bin
# （在 sim-sync 收敛清树范围之外，rebuild 不丢）。目录/文件缺失=钩子禁用
# （runtime 诚实降级 log，AI 回合不产 .tasklog/ 换手档案）----
# BATON_HOST_BIN_DIR=/opt/codeaudit-sim/bin

# ---- 卷缓存回收器（ADR-225 D6；缺省值见 engine/configs/codeaudit.yaml task.repo_cache_*。
# 需要覆盖时取消注释，并将键注入 task-service 容器 environment）----
# CODEAUDIT_TASK_REPO_CACHE_GC_ENABLED=true
# CODEAUDIT_TASK_REPO_CACHE_GC_INTERVAL_S=600
# CODEAUDIT_TASK_REPO_CACHE_TTL_S=86400
# CODEAUDIT_TASK_REPO_CACHE_ORPHAN_TTL_S=604800
# CODEAUDIT_TASK_REPO_CACHE_MAX_BYTES=21474836480
# ---- gateway source-file 按需重物化缓存上限（缺省 2GiB）----
# CODEAUDIT_SOURCEFILE_CACHE_MAX_BYTES=2147483648
