# CodeAudit 部署 env 模板（真实值放本目录 env，gitignore）
# JWT 签名密钥（openssl rand -hex 24）
CODEAUDIT_JWT_SECRET=
# CodeAudit API 网关在 LXC 107 上的发布端口（8080 已被 openshell-gateway 占用）
CODEAUDIT_HOST_GATEWAY=8090
# OpenShell 管理微服务（与 CD/openshell-manager/env 的 token 同值）
OPENSHELL_MANAGER_URL=http://gateway.internal:18800
OPENSHELL_MANAGER_TOKEN=
# MiMo 推理（可选，留空 = ai-inference 降级）
CODEAUDIT_MIMO_API_KEY=
CODEAUDIT_MIMO_ENDPOINT=

# ---- 卷缓存回收器（ADR-225 D6；缺省值见 engine/configs/codeaudit.yaml task.repo_cache_*。
