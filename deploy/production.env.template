# CodeAudit 生产态一键部署参数（deploy/production-deploy.sh 读取；不入 git）
# 首次运行 production-deploy.sh 会自动生成本文件（密钥随机、地址自动探测）；
# deploy/configure 在终端运行时会与部署人员交互确认关键参数（--yes 跳过问答）。
# 按需修改后重跑部署即收敛。所有变量都有安全缺省，可只改关心的一行。

# ---- 密钥（自动生成；JWT 换新会使全部登录态失效，谨慎重生成）----
CODEAUDIT_JWT_SECRET=<auto: openssl rand -hex 24>
OPENSHELL_MANAGER_TOKEN=<auto: openssl rand -hex 24，manager 与 engine 同值由本文件保证>

# ---- 地址（CODEAUDIT_ACCESS_IP 仅用于完成横幅/汇总显示；内部接线不依赖它）----
CODEAUDIT_ACCESS_IP=<auto: <宿主IP>>

# ---- 端口（冲突时交互改配落盘到这里，不动 compose）----
OPENSHELL_PORT=8080              # openshell-gateway gRPC（同号契约：沙箱经宿主此口回拨路由）
OPENSHELL_HEALTH_PORT=8081
CODEAUDIT_HOST_GATEWAY=8090      # engine 网关
CODEAUDIT_CONSOLE_PORT=8088      # web 控制台
CODEAUDIT_HOST_PG=5432
CODEAUDIT_HOST_REDIS=6379
CODEAUDIT_HOST_MINIO_API=9000
CODEAUDIT_HOST_MINIO_CONSOLE=9001
CODEAUDIT_HOST_KAFKA=9092

# ---- Kafka 广播地址（栈内互通缺省 kafka；宿主机侧程序要直连 Kafka 时改成宿主 IP）----
CODEAUDIT_KAFKA_ADVERTISED=kafka

# ---- 首启种子账号（admin/admin ROLE_ADMIN；用户档为内存存储，每次启动按此重播）----
# 生产一键档缺省 true——不开则全新栈无任何可登录用户（invitation 注册也需要首个
# admin）。登录后请立即改密；重启后回到本开关决定的状态是内存用户档既知边界。
CODEAUDIT_SEED_ADMIN=true

# ---- 网段（与宿主 LAN 冲突时才需要改；deploy 交互会检测重叠并给跳位建议）----
CODEAUDIT_ENGINE_SUBNET=10.10.110.0/24
# openshell-manager 网段钉在 manager/deploy/docker-compose.yml（10.10.109.0/24）

# ---- 沙箱服务路由域（纯字符串路由键：全程无 DNS 解析；决定沙箱服务 URL 形态与网关证书 SAN。
#      gateway server_sans 与 sse 冒烟断言经本键同源联动；改后重跑 deploy 即收敛）----
ROUTING_DOMAIN=sandbox.codeaudit.internal

# ---- 沙箱镜像（缺省 :latest；一般不动）----
#DSH_IMAGE=dsh-pentest-sse:latest

# ---- 联动键（deploy/configure 每次运行自动重算并回写，手改无效）----
# OPENSHELL_MANAGER_URL        = host.docker.internal:18800（内部常量——manager 是内部面
#                                非交互面，经 hosts 别名解析，零 DNS、零用户输入）
# OPENSHELL_GATEWAY_ENDPOINT   = host.docker.internal:$OPENSHELL_PORT        （manager→网关端点）
# CODEAUDIT_GATEWAY_DIAL_ADDR  = host.docker.internal:$OPENSHELL_PORT        （dsh-runtime→网关沙箱拨号）
# CODEAUDIT_GATEWAY_UPSTREAM   = host.docker.internal:$CODEAUDIT_HOST_GATEWAY（console /v1 反代；
#   dind 实测：指错到 openshell 网关 8080 会 404——联动重算防手误）
